# Core
PORT=3000
NODE_ENV=production
# VERY IMPORTANT: random 32+ char string, keep secret
SESSION_SECRET=change-me-to-a-long-random-string

# Your admin email — this account becomes the owner (admin panel)
ADMIN_EMAIL=you@gmail.com

# Google sign-in (see GOOGLE_LOGIN_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional if not https: localhost default is used in dev
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/auth/google/callback

# Durable storage: put your app online with data that survives restarts.
# FREE: create a database on upstash.com (Redis REST). 10k commands/month free is plenty.
STORAGE=upstash
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Binance read-only API keys for "auto-fetch my deposit address"
# CREATE IN BINANCE -> API Management -> enable ONLY "Enable Reading"
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional chain explorers for automatic payment confirmation (free keys)
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=